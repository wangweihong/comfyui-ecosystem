nr_id":"comfy-core","ver":"0.20.1","Node name for S&R":"PreviewImage","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":[]},{"id":919,"type":"ShowText|pysssss","pos":[-2596.6688207153843,301.8613315720503],"size":[288.5799475064273,547.4864267263731],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"text","name":"text","type":"STRING","link":828}],"outputs":[{"localized_name":"字符串","name":"STRING","shape":6,"type":"STRING","links":null}],"properties":{"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{}},"aux_id":"pythongosssss/ComfyUI-Custom-Scripts","ver":"609f3afaa74b2f88ef9ce8d939626065e3247469","Node name for S&R":"ShowText|pysssss"},"widgets_values":["一位东亚女性端坐于床榻之上，棕色长发如瀑布般垂落肩背，她身着粉色浴袍，衣襟微敞露出锁骨与胸前的柔润曲线，右手轻扶一本摊开的书，书页微翻，仿佛正沉浸于阅读或沉思。她的双腿裸露，在米色与棕色枕头的簇拥下，呈现出自然的弧度。床头是古朴的木质框架，纹理清晰，与床上的柔软形成对比。背景是一面灰色墙壁，色调沉静，为整个画面增添了一丝宁静与深邃。光线从窗边斜射进来，柔和地洒在她的脸庞与浴袍上，形成温暖的光影层次。镜头采用 35mm 焦距，光圈设为 f/2.8，景深适中，使前景的她的面部与手部细节清晰，中景的浴袍与书本层次分明，背景墙壁略显虚化，强化了视觉焦点。前景中，她的左手轻搭在床沿，手指微曲，仿佛随时准备翻动书页；中景里，粉色浴袍的褶皱与木质框架的棱角相互映衬，米色枕头的柔软与棕色枕头的厚重形成质感对比；背景墙壁的灰色调与前景的粉色、棕色相互呼应，营造出一种和谐而宁静的氛围。色调以暖色为主，光线略带金黄，使整个画面显得温暖而富有情感。整体构图平衡，视线从她的面部自然流向手部，再延伸至背景，形成一条清晰的视觉引导线。所有细节均符合物理规律，材质真实可信，没有多余的动力细节干扰，只有必要的动态元素增强氛围。无相机机身品牌提及，只输出精炼文字，无项目符号、无换行、无额外说明。"]},{"id":920,"type":"ToolBoxLatentSize","pos":[-2600.6557490611513,-398.19973935861236],"size":[270,102],"flags":{},"order":2,"mode":0,"inputs":[{"localized_name":"ratio","name":"ratio","type":"COMBO","widget":{"name":"ratio"},"link":null},{"localized_name":"resolution","name":"resolution","type":"COMBO","widget":{"name":"resolution"},"link":null},{"localized_name":"custom_width","name":"custom_width","type":"INT","widget":{"name":"custom_width"},"link":null},{"localized_name":"custom_height","name":"custom_height","type":"INT","widget":{"name":"custom_height"},"link":null}],"outputs":[{"localized_name":"width","name":"width","type":"INT","links":[829]},{"localized_name":"height","name":"height","type