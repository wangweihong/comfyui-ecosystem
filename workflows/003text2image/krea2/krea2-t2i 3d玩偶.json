lterbypass3.safetensors","weight":1,"clip_weight":1,"enabled":false,"parent_id":null},{"id":"lora1791204951358","item_type":"lora","display_name":"","custom_text":"","lora_name":"text2image/krea2/减少提示词拒绝Krea2_TextFusion_Refusal_Reduction.safetensors","weight":1,"clip_weight":1,"enabled":true,"parent_id":null}]},"isLocked":false,"viewMode":"normal","loraNameWidth":65,"customTextWidth":80,"folderColor":"#30353c","loraEntryColor":"#3a3a3a","enabledStateColor":"#4CAF50","separateWeights":false},{"id":186,"type":"ToolBoxText","pos":[-1218.196808569551,-394.93560161090767],"size":[530.9566730760775,439.52759007077407],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"text","name":"text","type":"STRING","links":[376,377]}],"properties":{"aux_id":"wangweihong/ComfyUI-ToolBox","ver":"956defdecbcac93099203387e4dd9ca3aab0ff01","Node name for S&R":"ToolBoxText","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["这是一幅高度精细、照片级写实的室内静物作品，画面中心是一尊 3D 打印的tifa人偶，她静静地立于木桌之上。主体是一尊精心制作的雕像，展现了tifa自信的站姿，她标志性的冒险探险家形象——紧身背心、短裤、靴子、腰带以及标志性的长发——都清晰可辨。人偶采用浅灰色斑点材质制成，仿若混凝土或陶瓷，触感细腻的哑光表面点缀着细小的深色斑点，近距离观察时，3D 打印的层纹清晰可见。人偶底座采用相同材质，几何造型，饰以浮雕图案和简洁的多边形表面，进一步强化了手工打印的质感。\n雕塑置于一张抛光的中棕色硬木桌上，桌面纹理清晰可见，略有划痕，底部附近还残留着一层薄薄的纤维。光线来自背景中的一扇窗户，柔和的自然光洒满整个画面，在雕塑的轮廓上投射出淡淡的高光，而微妙的阴影则突显了其立体造型和印刷纹理。背景经过柔和的虚化处理（浅景深），展现出室内景象：左侧是一个木架，上面摆放着一些装饰品，包括一个黑色小雕像、一个插着橙色花朵的玻璃罐和一个心形饰品；右侧是一个高高的薄荷绿色圆柱形容器和一个带有浮雕图案的透明玻璃罐。一个粉色耳朵的小毛绒玩具半隐于画面左侧边缘。\n镜头角度略微抬高，采用近距离、平视的视角，突显了雕像的雕塑细节、姿态和材质质感。构图紧密围绕雕像展开，引导观者的目光聚焦于其精湛的工艺和标志性的角色设计。色彩运用柔和而质朴——灰色、棕色和浅绿色——与灰白色的雕像和温暖的木质色调形成鲜明对比。整体美学风格简约、现代且富有触感，在居家环境中营造出一种匠人般的精准感和静谧的沉思氛围。画面中没有出现任何人物——焦点完全集中在静止的劳拉·克劳馥雕像及其周围环境上。"],"widgets_values_named":{"text":"这是一幅高度精细、照片级写实的室内静物作品，画面中心是一尊 3D 打印的tifa人偶，她静静地立于木桌之上。主体是一尊精心制作的雕像，展现了tifa自信的站姿，她标志性的冒险探险家形象——紧身背心、短裤、靴子、腰带以及标志性的长发——都清晰可辨。人偶采用浅灰色斑点材质制成，仿若混凝土或陶瓷，触感细腻的哑光表面点缀着细小的深色斑点，近距离观察时，3D 打印的层纹清晰可见。人偶底座采用相同材质，几何造型，饰以浮雕图案和简洁的多边形表面，进一步强化了手工打印的质感。\n雕塑置于一张抛光的中棕色硬木桌上，桌面纹理清晰可见，略有划痕，底部附近还残留着一层薄薄的纤维。光线来自背景中的一扇窗户，柔和的自然光洒满整个画面，在雕塑的轮廓上投射出淡淡的高光，而微妙的阴影则突显了其立体造型和印刷纹理。背景经过柔和的虚化处理（浅景深），展现出室内景象：左侧是一个木架，上面摆放着一些装饰品，包括一个黑色小雕像、一个插着橙色花朵的玻璃罐和一个心形饰品；右侧是一个高高的薄荷绿色圆柱形容器和一个带有浮雕图案的透明玻璃罐。一个粉色耳朵的小毛绒玩具半隐于画面左侧边缘。\n镜头角度略微抬高，采用近距离、平视的视角，突显了雕像的雕塑细节、姿态和材质质感。构图紧密围绕雕像展开，引导观者的目光聚焦于其精湛的工艺和标志性的角色设计。色彩运用柔和而质朴——灰色、棕色和浅绿色——与灰白色的雕像和温暖的木质色调形成鲜明对比。整体美学风格简约、现代且富有触感，在居家环境中营造出一种匠人般的精准感和静谧的沉思氛围。画面中没有出现任何人物——焦点完全集中在静止的劳拉·克劳馥雕像及其周围环境上。"}},{"id":188,"type":"ToolBoxPromptWriter","pos":[-553.1241406719249,-261.39331998161657],"size":[400,368],"flags":{},"order":9,"mode":4,"inputs":[{"localized_name":"id","name":"id","type":"INT","widget":{"name":"id"},"link":null},{"localized_name":"prompt","name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":376},{"localized_name":"language","name":"language","type":"COMBO","widget":{"name":"language"},"link":null},{"localized_name":"media_type","name":"media_type","type":"COMBO","widget":{"name":"media_type"},"link":null},{"localized_name":"prompt_type","name":"prompt_type","type":"COMBO","widget":{"name":"prompt_type"},"link":null},{"localized_name":"nsfw","name":"nsfw","type":"BOOLEAN","widget":{"name":"nsfw"},"link":null},{"localized_name":"content_format","name":"content_format","type":"COMBO","widget":{"name":"content_format"},"link":null},{"localized_name":"dynamic","name":"dynamic","type":"BOOLEAN","widget":{"name":"dynamic"},"link":null},{"localized_name":"width","name":"width","type":"INT","widget":{"name":"width"},"link":null},{"localized_name":"height","name":"height","type":"INT","widget":{"name":"height"},"link":null},{"localized_name":"tags","name":"tags","type":"STRING","widget":{"name":"tags"},"link":null}],"outputs":[{"localized_name":"id","name":"id","type":"INT","links":null},{"localized_name":"prompt","name":"prompt","type":"STRING","links":null},{"localized_name":"metadata","name":"metadata","type":"STRING","links":[375]}],"properties":{"aux_id":"wangweihong/Com