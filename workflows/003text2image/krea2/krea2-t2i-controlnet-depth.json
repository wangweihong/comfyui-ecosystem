1348039815678]},{"id":"c2aeabff-d676-499c-92e3-c7dc28dbaedc","name":"输入模式","type":"COMBO","linkIds":[32],"pos":[524.023474264206,1462.1348039815678]}],"outputs":[{"id":"a156dcd1-43de-4dbe-bfba-d81119781690","name":"文本","type":"STRING","linkIds":[21],"localized_name":"文本","pos":[1600.1659663867497,1282.1348039815678]}],"widgets":[],"nodes":[{"id":60,"type":"Gemma4TE_ImageInfer","pos":[922.8632184486489,979.0736818464999],"size":[593.3027479381008,656.122244270136],"flags":{},"order":1,"mode":0,"inputs":[{"localized_name":"gemma4模型","name":"gemma4模型","type":"GEMMA4LLAMA","link":16},{"localized_name":"图片","name":"图片","shape":7,"type":"IMAGE","link":17},{"localized_name":"输入模式","name":"输入模式","type":"COMBO","widget":{"name":"输入模式"},"link":32},{"localized_name":"提示词","name":"提示词","type":"STRING","widget":{"name":"提示词"},"link":31},{"localized_name":"系统提示词","name":"系统提示词","type":"STRING","widget":{"name":"系统提示词"},"link":30},{"localized_name":"最多帧数","name":"最多帧数","type":"INT","widget":{"name":"最多帧数"},"link":null},{"localized_name":"最大边长","name":"最大边长","type":"INT","widget":{"name":"最大边长"},"link":null},{"localized_name":"最大生成token","name":"最大生成token","type":"INT","widget":{"name":"最大生成token"},"link":null},{"localized_name":"温度","name":"温度","type":"FLOAT","widget":{"name":"温度"},"link":null},{"localized_name":"top_p","name":"top_p","type":"FLOAT","widget":{"name":"top_p"},"link":null},{"localized_name":"top_k","name":"top_k","type":"INT","widget":{"name":"top_k"},"link":null},{"localized_name":"seed","name":"seed","type":"INT","widget":{"name":"seed"},"link":24},{"localized_name":"输出think块","name":"输出think块","type":"BOOLEAN","widget":{"name":"输出think块"},"link":null},{"localized_name":"思考预算token","name":"思考预算token","type":"INT","widget":{"name":"思考预算token"},"link":null}],"outputs":[{"localized_name":"文本","name":"文本","type":"STRING","links":[21]}],"properties":{"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"aux_id":"tl2012tl/comfyUI-llama-TE","ver":"1e221a0f1551d6c15feb8126adc5072d4d9fe98c","Node name for S&R":"Gemma4TE_ImageInfer"},"widgets_values":["图片","","你是专注于图像反推提示词生成的专业AI助手，需基于用户上传的角色照片，分析并提取详细的图片信息，最终根据用户需求为图像生成模型生成提示词。请记住，我需要的是真实世界的人物，哪怕是一些动漫或二次元或游戏的角色也请给我描述成真人角色扮演一类的，并且最好要描述相机镜头和参数。\n\n具体执行步骤如下：\n【最高指令】\n1.语言固定输出流畅的常用英语，不要用古英语或教科书式的英语。\n2.用户需求为核心要求，要根据用户的需求对从图片中提取的图片信息进行优化修改，如无特殊要求，完全按照参考图生成提示词。\n2.格式绝对纯净：严禁使用 Markdown 符号（如星号、井号）、严禁中英对照括号、严禁任何解释性前缀或后缀。\n3.字数约束：最终生成的提示词总字数严格控制在 1000 字以内。\n\n【核心逻辑：多维解构模型】\n根据用户提供参考图，必须按照以下四个维度进行像素级的细节挖掘，如果用户提供额外的风格化提示词，以风格化提示词为核心对画面的描述进行合理的风格转换优化：\n\n1. 视觉基调层 (Visual Tone & Style)\n艺术属性：明确媒介（如：写实摄影、油画、赛博朋克插画、素描等）、时代感、艺术流派。\n色彩工程：禁止使用模糊词汇，必须使用精准术语（如：莫兰迪色系、高饱和度对比色、金黄色渐变等）。\n调色方案：明确画面的色彩关系（如互补色、类比色）、整体色温（冷/暖）、色彩饱和度倾向，以及是否采用特定的后期调色风格（如：胶片感、高调明亮、低调暗黑），最终颜色应应与用户需求匹配，例如用户要求单色，应只包含不同明度的黑白灰。要求描述精准到色彩的偏移方向与对比度表现。\n氛围感知：通过宏观光学现象描述，严禁使用微观粒子。必须使用：体积光、丁达尔效应、环境光遮蔽、逆光轮廓辉光等词汇。\n专用风格解析：monochrome ink wash style：单色水墨画风格，源于东方传统水墨画，仅用黑白灰三色，通过水的浓淡控制表现层次。笔触讲究\"墨分五色\"——焦、浓、重、淡、清。留白是重要手法，以虚代实，营造空灵意境。线条或奔放或含蓄，强调气韵生动而非形似；Monochrome stippling style：单色点画风格，完全由黑白灰三色密集小点构成画面，通过点的疏密表现明暗与体积。无线条勾勒，纯靠点的密度自然暗示轮廓。源于19世纪科学插画和铜版画，自带精密、复古、手工质感。远看如细腻素描，近看全是墨点；vintage tarot style：模仿百年老塔罗牌的神秘美学。手绘线条、低饱和大地色系、繁复边框装饰、大量神秘符号（月亮、星辰、花卉、几何）。人物造型古典优雅，带有新艺术运动（Art Nouveau）的装饰性；Textured abstract style：有秩序的厚涂油画：宽笔或软刮刀铺就的流畅笔触，颜料有适度厚度与光泽，色彩以主色调控制、点缀色克制，具象主体可辨识、背景可适度抽象，追求力量感与构图秩序的平衡；naive expressive sketch style：稚拙线描平涂插画：以肯定的手绘轮廓线勾勒主体，搭配高饱和度平涂色块与纸张噪点质感，造型简化天真，像儿童绘本或复古户外手册的插图，真诚、明快、带有印刷品的手工温度；Purple retro anime style：80-90年代日式赛璐珞动画的视觉复兴，但以紫色为绝对主色调。特征包括：高饱和度紫罗兰与深紫对比、荧光高光、粗黑线条、简化阴影、夸张眼型与发型、未来感或奇幻题材。带有强烈的怀旧电子感与霓虹都市氛围；Art Deco watercolor style：将20年代 Art Deco 的几何奢华与水彩的通透柔软结合。特征：对称构图、放射状线条、阶梯状造型、金属色与宝石色（金、翡翠绿、孔雀蓝）、水彩晕染的流动感。既有机械时代的锐利几何，又有手绘的温润气质；ethereal motion blur style：以长时间曝光或后期动态模糊创造超现实的流动感。主体边缘溶解、拖影、雾化，实体与虚空交融。色彩偏向冷调或过曝的苍白，营造梦境、记忆、灵魂出窍般的非现实体验。时间被视觉化，静止与运动同时存在；rainy window style：以布满雨滴的玻璃作为画面核心元素。窗外景物被水珠折射、扭曲、柔焦，形成天然的水墨晕染效果。冷暖对比（室内暖光 vs 窗外冷雨）、光斑散景、玻璃上的水痕纹理是三大视觉支柱。情绪基调孤独、安静、内省，带有电影感。\n2. 主体解构层 (Subject & Anatomy)\n核心主体：\n人物应包含国籍、年龄、面部特征、发型纹理、眼神细节。\n物体应包含种类、材质。 - **必须明确设定角色为亚洲人**，在描述外貌时加入亚洲人特征（例如必须包含：authentic Asian facial features, beautiful Asian woman/man）。\n表情描述：表情描写最优先最准确的：情绪氛围描写+可见的标志性动作+描述表情情绪+准确描述表情如微笑就直接要写出微笑，悲伤要写出悲伤，特殊特征（如豆豆眉、精灵耳朵）必须明确写出；否则不提。\n精细解剖：\n人物详细描述肌肉线条、骨骼结构、皮肤纹理（如毛孔）、服装等织物纹路及褶皱。\n物体详细描述材质纹理、外观构架。\n动态姿势：必须包含身体整体姿态、四肢空间位置、关节弯曲角度、重心移动感。\n3. 场景与构图层 (Composition & Environment)\n空间层次：明确前景、中景、远景的逻辑关系，描述元素的相对位置。\n构图模式：使用专业术语（如：对称构图、黄金分割、透视引导线）。\n4. 技术参数层 (Technical Parameters)\n写实摄影模式：包含相机型号、镜头焦距、光圈值、快门速度、ISO、白平衡及对焦模式。\n非写实艺术模式：自动切换为媒介参数（如：笔触厚度、纸张纹理、水彩晕染程度）。\n5. 必须标注精确年龄区间（跨度不超过2岁）。\n\n【强制约束与负面规避】\n1.视觉纯净度指令 (Visual Purity)：严禁在提示词中包含任何关于“水印 (Watermark)”、“文字标签 (Text/Label)”、“图片边框 (Border/Frame)”的描述。同时，严禁对主体进行任何形式的“纹身 (Tattoo/Body Art)”描写，确保皮肤表面的纯净与自然。\n2.正向引导原则：禁止使用否定词。必须使用积极、确定的描述（如：“极致锐利的对焦”而非“不要模糊”）。\n3.拒绝模糊性描述：禁止使用“大概”、“某种形状”。必须量化为精准的几何或色彩术语。\n严禁微观粒子：绝对禁止出现“微尘、漂浮粒子、空气颗粒”等词汇，统一使用宏观光学（如：光晕扩散）来表现氛围。\n4.最终提示词应完全符合客户对风格的需求，如没有指定风格将完全依照参考图生成。\n5.所有颜色描述应完全符合客户对色彩的需求，如没有指定色彩风格将完全依照参考图生成。\n\n【执行流程】\n1.分析阶段：全方位扫描图片，提取主体、背景、材质、光影、构图、相机参数等所有可见元素。\n2.转换阶段：根据图像类型和风格要求自动匹配对应的技术描述逻辑。\n3.生成阶段：严格按照“画面风格、核心元素、具体内容、构图方式”四个模块进行输出，确保语义权重从高到低排列。\n\n【格式校验】\n1.无污染检查：确认提示词中不存在任何关于水印、边框或纹身的描述。\n2.精准度检查：所有细节必须精准可量化，符合自然语言语法。\n3.输出规范：直接输出内容，不含任何额外解释，提示词中间禁止出现空行。\n4.输出语言：流畅的常用英语，不要用古英语或教科书式的英语",2,1024,1024,1,0.95,64,769257005971509,"randomize",false,0]},{"id":15,"type":"Gemma4TE_ModelLoader","pos":[597.2320924282685,1413.984857631042],"size":[270,202],"flags":{},"order":0,"mode":0,"inputs":[{"localized_name":"主模型","name":"主模型","type":"COMBO","widget":{"name":"主模型"},"link":25},{"localized_name":"视觉投影mmproj","name":"视觉投影mmproj","type":"COMBO","widget":{"name":"视觉投影mmproj"},"link":26},{"localized_name":"启用思考","name":"启用思考","type":"BOOLEAN","widget":{"name":"启用思考"},"link":27},{"localized_name":"上下文长度","name":"上下文长度","type":"INT","widget":{"name":"上下文长度"},"link":28},{"localized_name":"GPU层数","name":"GPU层数","type":"INT","widget":{"name":"GPU层数"},"link":29},{"localized_name":"KV缓存K类型","name":"KV缓存K类型","