:7,"type":"IMAGE","link":null},{"label":"image_4","name":"images.image_4","shape":7,"type":"IMAGE","link":null},{"label":"image_5","name":"images.image_5_1","shape":7,"type":"IMAGE","link":null},{"label":"image_6","name":"images.image_6","shape":7,"type":"IMAGE","link":null},{"label":"image_7","name":"images.image_7","shape":7,"type":"IMAGE","link":null},{"label":"image_8","name":"images.image_8","shape":7,"type":"IMAGE","link":null},{"label":"image_9","name":"images.image_9","shape":7,"type":"IMAGE","link":null},{"label":"image_10","name":"images.image_10","shape":7,"type":"IMAGE","link":null},{"label":"cache_device","name":"device","type":"COMBO","widget":{"name":"device"},"link":null},{"label":"dtype","name":"dtype","type":"COMBO","widget":{"name":"dtype"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[672,736,740]}],"properties":{"cnr_id":"comfy-core","ver":"0.37.0","previewExposures":[],"ue_properties":{"widget_ue_connectable":{"prompt":true,"steps":true,"switch":true,"width":true,"height":true,"scheduler":true,"scheduler_1":true,"device":true,"dtype":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[0,"使用参考图中的人物特征（外貌、衣物、皮肤细节），让参考图中的人物以标准站姿（双手自然下垂站立看向镜头）。\n一张高精度、干净极简的影视人物角色设定板，竖版9:16画幅，纯白背景。\n整体排版采用竖版四区块布局，整张画面分为上排和下排两个区域，每排各有左右两个独立展示区块。四个区块排布清晰、位置固定、间距均匀、留白干净，整体构图稳定，信息分区明确，画面整洁高级，写实影视质感，统一光线，统一人物一致性。\n\n整体布局：左上为人物正面肖像，右上为人物45度半身像，左下为正面全身站姿，右下为背面全身站姿。\n画面上排左侧区块放置人物脸部特写（胸口到头顶）：\n展示人物完整头部：头部居中，身体与脖子挺直、目光自然平视镜头，以面部为绝对视觉主体。画面从头顶发型上缘开始，向下最多到下巴及少量颈部位置，人物正对镜头，头部在该区块中明显放大，占据主要视觉面积，属于标准面部特写。\n画面上排右侧区块放置人物45度半身像：\n展示1张人物直立站立的左侧45度半身人物照。人物身体稳定朝向左侧45度侧前方，保持标准站姿，不扭身，不拧肩，不转回正面。人物头部朝向必须与身体朝向完全一致，面朝自身所面对的左侧45度侧前方，视线也与头部朝向一致，不看镜头，不回头，不转脸朝向镜头。双手自然下垂，双臂放松贴近身体两侧，姿态自然稳定。\n\n该区块必须严格裁切为从头顶到腰部的位置：完整头顶清晰可见，画面下边界严格落在腰部附近，不得高于胸下，不得低于臀部，不能展示腿部。画面中必须清晰展示完整头部、颈部、双肩、胸部、上半身躯干。人物面部保持中性，不做任何表情，不做任何情绪表达。\n\n人物头部需要：\n完整头部呈现\n\n画面下排左侧区块和右侧区块分别放置人物正面全身站姿、人物背面全身站姿：\n人物完整入镜，从头到脚完整展示，不裁切，双臂自然下垂，身体保持标准站立姿态，镜头平视。面部保持中性，不做任何表情，不做任何情绪表达。\n\n下排两个全身人物必须为同一个角色：头部、服装、体型、身高比例完全一致。\n\n四个区块中的人物都必须保持同一角色一致性：\n同一个头部、同一服装、同一身材比例、，不允许任何区块之间出现人物差异。所有区域保持统一曝光、统一色彩、统一光线、统一人物一致性。\n\n{{prompt}}\n\n输出要求：影视级写实人像质感（清晰的皮肤毛孔纹理、清晰的发丝细节），真实演员感，真实清晰的服装材质，全图各分区曝光与色彩一致，8K细节。","",1,25,true,1024,1024,"euler","simple",75993639581075,"image2image/qwen_image_2.1_bf16.safetensors","text_encoders/qwen3vl_8b_bf16.safetensors","vae/qwen_image_2.1_vae_bf16.safetensors","auto","default"],"widgets_values_named":{"resolution":0,"prompt":"使用参考图中的人物特征（外貌、衣物、皮肤细节），让参考图中的人物以标准站姿（双手自然下垂站立看向镜头）。\n一张高精度、干净极简的影视人物角色设定板，竖版9:16画幅，纯白背景。\n整体排版采用竖版四区块布局，整张画面分为上排和下排两个区域，每排各有左右两个独立展示区块。四个区块排布清晰、位置固定、间距均匀、留白干净，整体构图稳定，信息分区明确，画面整洁高级，写实影视质感，统一光线，统一人物一致性。\n\n整体布局：左上为人物正面肖像，右上为人物45度半身像，左下为正面全身站姿，右下为背面全身站姿。\n画面上排左侧区块放置人物脸部特写（胸口到头顶）：\n展示人物完整头部：头部居中，身体与脖子挺直、目光自然平视镜头，以面部为绝对视觉主体。画面从头顶发型上缘开始，向下最多到下巴及少量颈部位置，人物正对镜头，头部在该区块中明显放大，占据主要视觉面积，属于标准面部特写。\n画面上排右侧区块放置人物45度半身像：\n展示1张人物直立站立的左侧45度半身人物照。人物身体稳定朝向左侧45度侧前方，保持标准站姿，不扭身，不拧肩，不转回正面。人物头部朝向必须与身体朝向完全一致，面朝自身所面对的左侧45度侧前方，视线也与头部朝向一致，不看镜头，不回头，不转脸朝向镜头。双手自然下垂，双臂放松贴近身体两侧，姿态自然稳定。\n\n该区块必须严格裁切为从头顶到腰部的位置：完整头顶清晰可见，画面下边界严格落在腰部附近，不得高于胸下，不得低于臀部，不能展示腿部。画面中必须清晰展示完整头部、颈部、双肩、胸部、上半身躯干。人物面部保持中性，不做任何表情，不做任何情绪表达。\n\n人物头部需要：\n完整头部呈现\n\n画面下排左侧区块和右侧区块分别放置人物正面全身站姿、人物背面全身站姿：\n人物完整入镜，从头到脚完整展示，不裁切，双臂自然下垂，身体保持标准站立姿态，镜头平视。面部保持中性，不做任何表情，不做任何情绪表达。\n\n下排两个全身人物必须为同一个角色：头部、服装、体型、身高比例完全一致。\n\n四个区块中的人物都必须保持同一角色一致性：\n同一个头部、同一服装、同一身材比例、，不允许任何区块之间出现人物差异。所有区域保持统一曝光、统一色彩、统一光线、统一人物一致性。\n\n{{prompt}}\n\n输出要求：影视级写实人像质感（清晰的皮肤毛孔纹理、清晰的发丝细节），真实演员感，真实清晰的服装材质，全图各分区曝光与色彩一致，8K细节。","negative_prompt":"","cfg":1,"steps":25,"switch":true,"width":1024,"height":1024,"scheduler":"euler","scheduler_1":"simple","seed":75993639581075,"unet_name":"image2image/qwen_image_2.1_bf16.safetensors","clip_name":"text_encoders/qwen3vl_8b_bf16.safetensors","vae_name":"vae/qwen_image_2.1_vae_bf16.safetensors","device":"auto","dtype":"default"}},{"id":479,"type":"Image Comparer (rgthree)","pos":[1249.7514561308676,2871.600955858446],"size":[388.7554572967068,314.07734980410623],"flags":{},"order":13,"mode