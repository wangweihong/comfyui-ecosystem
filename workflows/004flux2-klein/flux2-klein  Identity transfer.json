sors","default"]},{"id":180,"type":"VAELoader","pos":[2.6079852090338105,565.0802854655028],"size":[270,58],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"vae名称","name":"vae_name","type":"COMBO","widget":{"name":"vae_name"},"link":null}],"outputs":[{"localized_name":"VAE","name":"VAE","type":"VAE","links":[586,650]}],"properties":{"cnr_id":"comfy-core","ver":"0.17.0","Node name for S&R":"VAELoader","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["flux2/flux2-vae.safetensors"]},{"id":235,"type":"VAEEncode","pos":[513.9319662998528,1125.7617872911928],"size":[140,46],"flags":{},"order":13,"mode":0,"inputs":[{"localized_name":"像素","name":"pixels","type":"IMAGE","link":649},{"localized_name":"vae","name":"vae","type":"VAE","link":650}],"outputs":[{"localized_name":"Latent","name":"LATENT","type":"LATENT","links":[651,652,672]}],"properties":{"cnr_id":"comfy-core","ver":"0.19.1","Node name for S&R":"VAEEncode","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[]},{"id":249,"type":"MarkdownNote","pos":[452.30297422017225,-239.2568916570047],"size":[739.0011087251595,371.68357190142956],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[" Identity Guidance Controls identity correction during the sampling loop.\n身份指导控制采样环路中的身份校正。\n\n    strength: how hard to pull toward the reference. 0.3 to 0.5 is a good range\n    力量 ：向参考方向拉扯的力度。0.3 到 0.5 是一个不错的范围\n\n    start_percent / end_percent: when the correction is active during denoising. Leaving some room at the end (0.8) lets textures refine naturally\n    start_percent / end_percent：在去噪过程中校正处于激活状态。在结尾留出一些空间（0.8）让纹理自然细化\n\n    mode: adaptive preserves prompt-driven changes, direct locks everything, channel_match transfers color/feature palette only\n    模式 ：自适应保留提示驱动的更改，直接锁定所有内容，channel_match 仅传输颜色/功能调色板\n\n\n Identity Feature Transfer Controls feature-level steering inside the attention blocks.\n身份特征转移控制功能级转向，置于注意力块内。\n\n    strength: per-block intensity, cumulative so start low. 0.15 to 0.25\n    强度 ：按每块计时，累计，所以从低剂量开始。0.15 到 0.25\n\n    start_block / end_block: which blocks are active. 0 to 23 covers the full range\n    start_block / end_block：哪些方块处于激活状态。0 到 23 涵盖了整个范围\n\n    mode: cosine_pull for per-feature matching, topk_replace to only affect the most similar tokens, mean_transfer for overall character flavor\n    模式 ：cosine_pull，用于每个功能匹配，topk_replace 只影响最相似的标记，mean_transfer 整体角色特色\n\n    top_k_percent: how many tokens are affected in topk_replace mode\n    top_k_percent：topk_replace 模式中影响的代币数量\n\nBoth can be used together. Guidance handles the macro, Feature Transfer handles the micro.\n两者可以一起使用。指导负责宏，特征转移负责微观。\nfor maximum color preservation you can use FLUX.2 Klein Identity Guidance and choose the channel_match mode, this will transfer the colors only, leaving the rest of the work to FLUX.2 Klein Identity Feature Transfer\n为了最大限度地保留颜色，可以使用 FLUX.2 Klein 身份指导并选择 channel_match 模式，这样只传输颜色，其余工作就交给 FLUX.2 Klein 身份特征传输\n\n"],"color":"#432","bgcolor":"#653"},{"id":250,"type":"MarkdownNote","pos":[1509.97565191714,-261.6860259777114],"size":[840.765870376174,408.20657741504476],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["https://www.reddit.com/r/StableDiffusion/comments/1somo2r/coming_up_tomorrow_flux2klein_identity_transfer/"],"color":"#432","bgcolor":"#653"},{"id":241,"type":"IdentityGuidance","pos":[566.2099975238312,223.7955056301338],"size":[328.8013671875,150],"flags":{},"order":18,"mode":0,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":684},{"localized_name":"identity_latent","name":"identity_latent","type":"LATENT","link":672},{"localized_name":"strength","name":"strength","