er":"16890aa76b7cd39c68205d84cf7f4a029d8f4669","Node name for S&R":"Ideogram4PromptBuilderKJ","cnr_id":"comfyui-kjnodes","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"dockPinned":true,"dockGraph":{"x":36.911162725506095,"y":428.420019452963,"w":528,"h":928},"docked":true,"dockMin":false},"widgets_values":[736,1104,"1980s horror movie poster illustration of a little girl in her pajamas kneeling on top of her fuzzy house slippers, facing away from the viewer, placing both spread hands flat on the screen of a large woodgrain CRT television. The poster is monochromatic with a cold blue color palette. The only light source is the static noise on the television screen. ","","art_style","1980s, Airbrush gradients, Glossy painted highlights, Commercial advertising artwork,","monochromatic, limited color palette, 1980s horror movie poster, stylized realism, illustration","eerie blue glow around TV and girl, pitch black, solid black, TV glow only,","Airbrushed painted movie poster, Airbrushed acrylic illustration and painted movie poster art","[\"#000000\",\"#c5dce0\",\"#e0e0e0\"]","[{\"x\":0.2153091543764707,\"y\":0.2778019082742874,\"w\":0.5882250347811597,\"h\":0.2232840527125466,\"type\":\"obj\",\"text\":\"\",\"desc\":\"Large woodgrain CRT television, 1980 TV cabinet, rounded cathode-ray tube screen. The screen is displaying monochrome television static and the blue-white CRT glow is the only source of light on the poster. The TV cabinet is nearly entirely in shadow, with shadow wrapping around the edges and sides and obscuring details.\",\"palette\":[\"#000000\",\"#c5dce0\",\"#dedede\"]},{\"x\":0.3967411277433298,\"y\":0.3377832737205578,\"w\":0.1732918628447867,\"h\":0.2407593133128228,\"type\":\"obj\",\"text\":\"\",\"desc\":\"A young little girl wearing a white nightgown with a barely visible small blue diamond pattern is kneeling in front of the TV screen, facing away from the viewer, seen from behind. Her small figure is nearly entirely in shadow with harsh shadows on her back, hair, and slippers, with only strong rim light from the TV screen wrapping around her edges.\",\"palette\":[\"#000000\",\"#c5dce0\",\"#ebebeb\"]},{\"x\":0.4224558523984205,\"y\":0.33934226207830104,\"w\":0.11947537071597936,\"h\":0.1387725647198293,\"type\":\"obj\",\"text\":\"\",\"desc\":\"The little girl's long straight blond hair seen from behind.\",\"palette\":[\"#000000\",\"#c5dce0\",\"#dedede\"]},{\"x\":0.3883428829193102,\"y\":0.5342786373941844,\"w\":0.18763761979831928,\"h\":0.05152950928699451,\"type\":\"obj\",\"text\":\"\",\"desc\":\"The bottom rubber soles of her house slippers, folded in underneath her as she kneels on top of them. The soles of the slippers that are visible are rubber.\",\"palette\":[]},{\"x\":0.5558875120167778,\"y\":0.33764614024155276,\"w\":0.0710161957853287,\"h\":0.045453662410070594,\"type\":\"obj\",\"text\":\"\",\"desc\":\"The little girl's spread hand, placed flat against the CRT TV screen.\",\"palette\":[\"#000000\",\"#c5dce0\",\"#cccccc\"]},{\"x\":0.3428389777794916,\"y\":0.3399652402168886,\"w\":0.0710161957853287,\"h\":0.045453662410070594,\"type\":\"obj\",\"text\":\"\",\"desc\":\"The little girl's spread hand, placed flat against the CRT TV screen.\",\"palette\":[\"#000000\",\"#c5dce0\",\"#e2e2e2\"]},{\"x\":0.5966019104982422,\"y\":0.5390533507462227,\"w\":0.20908188414519424,\"h\":0.056121256216948634,\"type\":\"obj\",\"text\":\"\",\"desc\":\"A discarded 1970s teddy bear plush, laying discard on the carpet on it's back, eerily edge lit by the glow of the TV screen.\",\"palette\":[]},{\"x\":0.6037641772495926,\"y\":0.5422952296282433,\"w\":0.08212641882246263,\"h\":0.048785447058848574,\"type\":\"obj\",\"text\":\"\",\"desc\":\"Teddy bear head facing straight up.\",\"palette\":[]},{\"x\":0.18736620684028335,\"y\":0.5341332829000869,\"w\":0.6282989704351672,\"h\":0.10124238732563728,\"type\":\"obj\",\"text\":\"\",\"desc\":\"A small patch of illumination from the TV showin