orch\n0.11.x\t2.11.x\n0.10.x\t2.10.x\n0.9.x\t2.10.x (部分)\n0.8.x\t2.9.x\n0.7.x\t2.8.x\nnightly\tnightly\n\n"],"color":"#432","bgcolor":"#653"}],"links":[[3,1,0,3,7,"STRING"],[4,3,0,4,0,"AUDIO"],[9,6,0,1,0,"AUDIO"],[10,6,0,3,0,"AUDIO"],[12,8,0,3,2,"STRING"]],"groups":[],"config":{},"extra":{"links_added_by_ue":[],"ue_links":[],"0246.VERSION":[0,0,4],"ds":{"scale":0.7972024500000009,"offset":[874.6090406411633,641.9619844413867]},"frontendVersion":"1.23.0","VHS_latentpreview":false,"VHS_latentpreviewrate":0,"VHS_MetadataImage":true,"VHS_KeepIntermediate":true,"workflowRendererVersion":"Vue-corrected"},"version":0.4}