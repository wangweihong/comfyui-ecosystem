DEL","links":[20407]}],"properties":{"aux_id":"kijai/ComfyUI-KJNodes","ver":"d3cfe21625e5170126ce06fbfcfe1d88108688c3","Node name for S&R":"ModelPatchTorchSettings","cnr_id":"comfyui-kjnodes","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[true],"widgets_values_named":{"enable_fp16_accumulation":true},"color":"#222","bgcolor":"#000"},{"id":5876,"type":"H3SLAAttention","pos":[-410,-420],"size":[290,370],"flags":{},"order":1,"mode":4,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":20409},{"localized_name":"sparsity_ratio","name":"sparsity_ratio","type":"FLOAT","widget":{"name":"sparsity_ratio"},"link":null},{"localized_name":"block_size","name":"block_size","type":"COMBO","widget":{"name":"block_size"},"link":null},{"localized_name":"min_seq_len","name":"min_seq_len","shape":7,"type":"INT","widget":{"name":"min_seq_len"},"link":null},{"localized_name":"dense_last_steps","name":"dense_last_steps","shape":7,"type":"INT","widget":{"name":"dense_last_steps"},"link":null},{"localized_name":"protect_audio","name":"protect_audio","shape":7,"type":"BOOLEAN","widget":{"name":"protect_audio"},"link":null},{"localized_name":"enabled","name":"enabled","shape":7,"type":"BOOLEAN","widget":{"name":"enabled"},"link":null},{"localized_name":"dense_steps","name":"dense_steps","shape":7,"type":"STRING","widget":{"name":"dense_steps"},"link":null},{"localized_name":"dense_backend","name":"dense_backend","shape":7,"type":"COMBO","widget":{"name":"dense_backend"},"link":null},{"localized_name":"disable_fp16_accum","name":"disable_fp16_accum","shape":7,"type":"BOOLEAN","widget":{"name":"disable_fp16_accum"},"link":null},{"localized_name":"stabilize_motion","name":"stabilize_motion","shape":7,"type":"BOOLEAN","widget":{"name":"stabilize_motion"},"link":null},{"localized_name":"Protect Vid/Ref","name":"reference_protection","shape":7,"type":"COMBO","widget":{"name":"reference_protection"},"link":null},{"localized_name":"tail_correction","name":"tail_correction","shape":7,"type":"BOOLEAN","widget":{"name":"tail_correction"},"link":null},{"localized_name":"use_int8_qk","name":"use_int8_qk","shape":7,"type":"BOOLEAN","widget":{"name":"use_int8_qk"},"link":null},{"localized_name":"engine","name":"engine","shape":7,"type":"COMBO","widget":{"name":"engine"},"link":null}],"outputs":[{"localized_name":"MODEL","name":"MODEL","type":"MODEL","links":[20385]}],"title":"1. H3 Sparse Attention (SLA)","properties":{"Node name for S&R":"H3SLAAttention","cnr_id":"plaguekind-nodes"},"widgets_values":[0.7,"128",8192,1,false,true,"0","comfy_kitchen",true,false,"Heavy Enforcement",false,true,"comfy_kitchen"],"widgets_values_named":{"sparsity_ratio":0.7,"block_size":"128","min_seq_len":8192,"dense_last_steps":1,"protect_audio":false,"enabled":true,"dense_steps":"0","dense_backend":"comfy_kitchen","disable_fp16_accum":true,"stabilize_motion":false,"reference_protection":"Heavy Enforcement","tail_correction":false,"use_int8_qk":true,"engine":"comfy_kitchen"}},{"id":5883,"type":"MarkdownNote","pos":[-1510,-840],"size":[700,320],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"Note: Speed Patches (PK)","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["## Speed Patches — PK / H3 SLA\n\nChain applies bottom-up on the MODEL. Toggle each group on/off with the bypasser above.\n\n- **1. FP16 Accumulation** (`ModelPatchTorchSettings`): free speed on RTX 30xx+ / most modern GPUs. Safe to leave on.\n- **2. LowVRAM Attention** (`MiniMaxLowVRAMAttention`): splits attention into head chunks. Reduces peak VRAM; tiny cost, sometimes a small speedup. Widget: `head_chunks` (default 4).\n- **3. Chunk FeedForward** (`MiniMaxChunkFeedForward`): splits FF blocks. Reduces peak VRAM at longer sequence lengths. Widgets: `chunks` (2–4), `seq_threshold` (4096).\n- **4. H3 SLA Attention** (`H3SLAAttention`): the big one. Sparse Linear Attention — main speedup. `sparsity_ratio` 0.9 keeps 10% of tokens for very fast, decent-quality; drop to ~0.7 if you see artifacts. `dense_last_steps` controls how many final steps run dense (better quality tail).\n\n### Wiring\n\nFeed the raw `MODEL` from `UNETLoader` into `model`. Take the output `MODEL` to whatever comes next (sampler / patcher).\n\n### Notes\n\n- SLA patches attention — anything else patching attention should sit *before* it in the chain. That is why H3SLAAttention is last.\n- `protect_audio=True` avoids audio-latent glitches at some speed cost. Leave on unless testing.\n- If the workflow refuses to load, install `comfyui-kjnodes` and `plaguekind-nodes` (H3SLAAttention lives in one of these packs)."],"widgets_values_named":{"text":"## Speed Patches — PK / H3 SLA\n\nChain applies bottom-up on the MODEL. Toggle each group on/off with the bypasser above.\n\n- **1. FP16 Accumulation** (`ModelPatchTorchSettings`): free speed on RTX 30xx+ / most modern GPUs. Safe to leave on.\n- **2. LowVRAM Attention** (`MiniMaxLowVRAMAttention`): splits attention into head chunks. Reduces peak VRAM; tiny cost, sometimes a small speedup. Widget: `head_chunks` (default 4).\n- **3. Chunk FeedForward** (`MiniMaxChunkFeedForward`): splits FF blocks. Reduces peak VRAM at longer sequence lengths. Widgets: `chunks` (2–4), `seq_threshold` (4096).\n- **4. H3 SLA Attention** (`H3SLAAttention`): the big one. Sparse Linear Attention — main speedup. `sparsity_ratio` 0.9 keeps 10% of tokens for very fast, decent-quality; drop to ~0.7 if you see artifacts. `dense_last_steps` controls how many final steps run dense (better quality tail).\n\n### Wiring\n\nFeed the raw `MODEL` from `UNETLoader` into `model`. Take the output `MODEL` to whatever comes next (sampler / patcher).\n\n### Notes\n\n- SLA patches attention — anything else patching attention should sit *before* it in the chain. That is why H3SLAAttention is last.\n- `protect_audio=True` avoids audio-latent glitches at some speed cost. Leave on unless testing.\n- If the workflow refuses to load, install `comfyui-kjnodes` and `plaguekind-nodes` (H3SLAAttention lives in one of these packs)."},"color":"#222","bgcolor":"#000"},{"id":5882,"type":"MiniMaxLowVRAMAttention","pos":[-1250,-410],"size":[320,60],"flags":{},"order":2,"mode":4,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":20407},{"localized_name":"head_chunks","name":"head_chunks","type":"INT","widget":{"name":"head_chunks"},"link":null}],"outputs":[{"localized_name":"model","name":"model","type":"MODEL","links":[20408]}],"properties":{"aux_id":"kijai/ComfyUI-KJNodes","ver":"d3cfe21625e5170126ce06fbfcfe1d88108688c3","Node name for S&R":"MiniMaxLowVRAMAttention","cnr_id":"comfyui-kjnodes","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[4],"widgets_values_named":{"head_chunks":4},"color":"#222","bgcolor":"#000"}],"groups":[{"id":1,"title":"1. FP16 Accumulation","bounding":[-1650,-480,330,160],"color":"#8AA","flags":{}},{"id":2,"title":"2. LowVRAM Attention","bounding":[-1280,-480,380,160],"color":"#8AA","flags":{}},{"id":3,"title":"3. Chunk FeedForward","bounding":[-880,-480,380,190],"color":"#8AA","flags":{}}],"links":[{"id":20385,"origin_id":5876,"origin_slot":0,"target_id":-20,"target_slot":0,"type":"MODEL"},{"id":20406,"origin_id":-10,"origin_slot":0,"target_id":5885,"target_slot":0,"type":"MODEL"},{"id":20407,"origin_id":5885,"origin_slot":0,"target_id":5882,"target_slot":0,"type":"MODEL"},{"id":20408,"origin_id":5882,"origin_slot":0,"target_id":5884,"target_slot":0,"type":"MODEL"},{"id":20409,"origin_id":5884,"origin_slot":0,"target_id":5876,"target_slot":0,"type":"MODEL"}],"extra":{"pixaromaGroups":[],"ue_links":[],"links_added_by_ue":[]}}]},"config":{},"extra":{"frontendVersion":"1.30.6","ds":{"scale":1.3513057093103962,"offset":[595.0886819917523,-198.27246906177928]},"ue_links":[],"links_added_by_ue":[]},"version":0.4}