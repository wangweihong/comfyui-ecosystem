264-mp4","pix_fmt":"yuv420p","crf":19,"save_metadata":true,"trim_to_audio":false,"pingpong":false,"save_output":true,"videopreview":{"hidden":false,"paused":false,"params":{"filename":"v2v_00013-audio.mp4","subfolder":"videos/minimaxh3/v2v","type":"output","format":"video/h264-mp4","frame_rate":24,"workflow":"v2v_00013.png","fullpath":"/root/ComfyUI/output/videos/minimaxh3/v2v/v2v_00013-audio.mp4"}}}},{"id":142,"type":"ToolBoxText","pos":[-1551.5960905495103,6176.402054330361],"size":[518.5800000000002,348.8299999999999],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"text","name":"text","type":"STRING","links":[292]}],"properties":{"aux_id":"wangweihong/ComfyUI-ToolBox","ver":"ef8d6a4c6c7f254554a03f3e69c6b5a46bcce19d","Node name for S&R":"ToolBoxText","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["参考图片内容生成视频\n电影级哥特悬疑短片，16:9横屏，24fps，真人电影质感，暗黑维多利亚时代古堡，封闭式暴风雪山庄谋杀谜案。\n\n【人物与连续性锁定】\n全片始终只有六名成年女性，人物身份、面部、发型和服装全程保持一致：\n1. 黑发女子，身穿黑色露肩晚礼服，手持黑色羽毛折扇，神情冷静锐利；\n2. 红发女子，身穿深祖母绿色丝绒长裙，气质强势；\n3. 银灰短发女子，佩戴细框眼镜，身穿黑色燕尾服与白色荷叶领衬衫，像冷静的调查者；\n4. 金色长卷发女子，身穿白色荷叶领衬衫与黑色礼服外套，是中毒者；\n5. 白金长发女子，身穿黑色蕾丝长裙，手持一支暗红玫瑰；\n6. 黑色长发女子，身穿黑色高领礼服，手中端着红酒杯，始终沉默观察。\n\n不得增加第七个人，不得改变人物数量，不得中途换脸、换发型或换服装。\n\n【00:00-00:04｜华宴暗涌】\n暴风雨夜晚，古老奢华的哥特式宴会厅，深墨绿色墙壁、黑色木质家具、巨大水晶吊灯和大量摇曳蜡烛。六名女性分散站在铺着精致餐具的长桌周围，彼此保持距离，空气凝固。摄影机从宴会厅远景缓慢向前推进，冷青色月光从高窗射入，与暖金色烛光形成强烈冷暖对比。所有人沉默地互相审视。\n\n低沉女性画外音：\n“今夜的客人，谁都别想先走。”\n\n【00:04-00:07】\n切换到黑发持扇女子的中近景。她缓慢抬起黑色羽毛折扇遮住半张脸，只有冰冷的双眼露出，目光依次扫过房间里的每一个人。摄影机轻微推近，烛火倒映在她的瞳孔中，表情克制但充满怀疑。\n\n【00:07-00:09】\n极近距离特写：深绿色丝绒衣袖下的一只手悄悄握紧镶嵌金色纹饰的短匕首，指节因用力微微发白。刀锋只露出一小部分，反射出一道冰冷亮光。快速切黑，伴随轻微金属摩擦声。\n\n【00:09-00:12｜玫瑰染血】\n白金长发女子独自站在厚重的黑色窗帘旁，手持一支暗红玫瑰。玫瑰花瓣边缘带着湿润水珠，一滴深红液体沿花茎缓慢滑落。她身旁的小桌上放着一只精致方形香水瓶，琥珀色液体在烛光下流动。摄影机从玫瑰缓慢横移到香水瓶，再抬升至她没有表情的脸。\n\n【00:12-00:15】\n银灰短发、佩戴眼镜的女子俯身检查香水瓶。她戴着黑色手套，用一根细银针轻触瓶口。摄影机近距离环绕她的侧脸，镜片中突然掠过一道像刀锋般的冷光。她立刻抬眼，但身后只有昏暗烛火与模糊人影。\n\n【00:15-00:17】\n微距特写：香水瓶放在一张泛黄的手写信纸旁，一片暗红玫瑰花瓣落入画面。琥珀色液体内部出现极细微的黑色烟雾状扩散，暗示其中含有致命毒素。\n\n低沉女性画外音：\n“这瓶香水，只有死者用过。”\n\n【00:17-00:21｜真相之镜】\n回到宴会厅全景。水晶吊灯突然剧烈闪烁，房间陷入短暂黑暗。重新亮起时，六名女性已经围在长桌周围。金色长卷发的白衣女子突然呼吸困难，身体僵硬，随后向后倒在椅子上。其余五人同时后退或转头，表情各不相同：震惊、冷漠、恐惧、怀疑。摄影机快速向后拉远，展示整个封闭房间。\n\n【00:21-00:24】\n金发女子面部中近景。她脸色苍白，眼角和眼白出现极淡的异常红色，呼吸急促。她死死看向房间尽头的巨大古董镜子，仿佛终于意识到什么。摄影机缓慢推近她的眼睛，眼中映出镜子的轮廓。\n\n【00:24-00:27】\n摄影机转向巨大金边古董镜。现实中的五名站立女子与一名倒下女子都清晰可见，但镜中某个女人的倒影动作与本人不一致：现实中的手自然垂下，镜中倒影却把一把匕首藏在裙摆后方。不要明确显示是哪一名女子，只呈现模糊、难以辨认的异常剪影。\n\n镜面从中央突然产生细密裂纹，裂纹快速向四周扩散。\n\n低沉女性画外音：\n“凶手，就在我们六人之中。”\n\n【00:27-00:30｜悬念结尾】\n镜面彻底碎裂，但碎片没有立刻掉落。每一块镜片分别映出一名女子的眼睛、手部、红玫瑰、香水瓶、红酒杯和匕首。摄影机高速推进其中一块镜片，镜片中一双眼睛突然看向镜头。吊灯瞬间熄灭，画面切为纯黑。\n\n最后响起清脆的镜片落地声、低沉钟声和一次短促心跳声。\n\n整体视觉风格：暗调哥特电影、古典谋杀悬疑、墨绿与黑金主色、低饱和肤色、深红色作为危险视觉锚点、真实皮肤和布料纹理、精致烛光、体积光、浅景深、轻微胶片颗粒、克制表演、稳定电影运镜。\n\n镜头节奏：前半段庄严缓慢，线索特写逐渐加速，人物倒下后节奏骤然紧张，最后以镜面碎裂形成爆发式高潮。"]},{"id":115,"type":"ResolutionSelector","pos":[-1480,5610],"size":[270,170],"flags":{},"order":13,"mode":0,"showAdvanced":false,"inputs":[{"localized_name":"宽高比","name":"aspect_ratio","type":"COMBO","widget":{"name":"aspect_ratio"},"link":null},{"localized_name":"百万像素","name":"megapixels","type":"FLOAT","widget":{"name":"megapixels"},"link":null},{"localized_name":"倍数","name":"multiple","type":"INT","widget":{"name":"multiple"},"link":null}],"outputs":[{"localized_name":"宽度","name":"width","type":"INT","links":[276]},{"localized_name":"高度","name":"height","type":"INT","links":[277]}],"title":"Resolution Selector (Size)","properties":{"cnr_id":"comfy-core","ver":"0.29.2","Node name for S&R":"ResolutionSelector","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["16:9 (Widescreen)",0.4,32],"color":"#322","bgcolor":"#533"},{"id":132,"type":"PrimitiveFloat","pos":[-1436.0770000000002,5819.351999999999],"size":[270,70],"flags":{},"order":14,"mode":0,"inputs":[{"localized_name":"值","name":"value","type":"FLOAT","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"浮点","name":"FLOAT","