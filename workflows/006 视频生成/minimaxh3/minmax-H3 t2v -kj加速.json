","name":"value","type":"FLOAT","widget":{"name":"value"},"link":243}],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[241]},{"name":"AUDIO","type":"AUDIO","links":[242]}],"properties":{"cnr_id":"comfy-core","ver":"0.29.2","previewExposures":[],"ue_properties":{"widget_ue_connectable":{"width":true,"height":true,"value_1":true,"vae_name_1":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["0-3s:镜头拍摄一只老鼠，镜头外一双手将摄像头戴到老鼠头上，\n3-7s:摄像机为老鼠的视角。老鼠快速穿过一个又一个门洞。（背景音乐是猫和老鼠配乐)。遇到越来越多的老鼠。老鼠进入老鼠窝，看起来一个小型的Disco.一群老鼠在跳disco",1344,768,15,454227676781336,"minmaxh3/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors","text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors","vae/minimax_h3_video_vae_fp16.safetensors","vae/minimax_h3_audio_vae_fp32.safetensors","auto",24]},{"id":121,"type":"ToolBoxText","pos":[-1126.2053461367113,4467.299028992492],"size":[578.0226312602945,518.9119225186423],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"text","name":"text","type":"STRING","links":[233,235]}],"properties":{"aux_id":"wangweihong/ComfyUI-ToolBox","ver":"ef8d6a4c6c7f254554a03f3e69c6b5a46bcce19d","Node name for S&R":"ToolBoxText","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["integrated_multimodal_description: [Shot 1] 第一人称视角，正对一位坐在床沿的性感美丽的中国女子。她皮肤白皙，紧致无皱纹,胸部饱满。她柔和鹅蛋脸，真实自然五官。她以约145°侧身面对镜头，身穿凸显丰满胸部的精致蕾丝情趣内衣。她转头看向镜头，表情成熟而诱惑，一边用略带无奈却带着邀请意味的成熟声音接过镜头递来的安全套：<d>[Chinese]你爸不在家</d>。随后上身与头部向前伸向镜头，带着质问的姿态继续说：<d>[Chinese] 你就送我这个？</d> 眼睛向下移向画面下方（主角身体方向），补充道：<d>[Chinese] 嗯？！</d> 她保持向下注视约两秒沉默，然后发出一声无奈又带点好笑的（S1）：<d>[Chinese] 哼！</d> 她转过头，爬上床，一边爬一边说：<d>[Chinese] 我就知道你小子没安好心..</d> 上到床垫后保持跪爬姿势，回过头看向镜头，表情宠溺，右手缓慢把右侧内衣肩带从肩膀滑下，同时轻声说：<d>[Chinese] 行了，过来吧~</d> \n\noverall_soundscape: 安静卧室环境声，轻微布料摩擦、她爬上床时床垫受压的轻响、皮肤与布料的细微摩擦声，以及私密室内的自然房间底噪。她成熟、带呼吸感、诱惑的说话声从手机视角清晰近距离拾取。无其他对白。\n\nnon_diegetic_music: 非常稀疏、低音量的氛围电子铺底，带有缓慢私密的脉动，始终低调，不盖过对白与自然音效。"]},{"id":125,"type":"VHS_VideoCombine","pos":[-133.98704815440857,5097.075654689092],"size":[443.9132537886037,588.2175104802088],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":241},{"localized_name":"audio","name":"audio","shape":7,"type":"AUDIO","link":242},{"localized_name":"meta_batch","name":"meta_batch","shape":7,"type":"VHS_BatchManager","link":null},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":null},{"localized_name":"frame_rate","name":"frame_rate","type":"FLOAT","widget":{"name":"frame_rate"},"link":244},{"localized_name":"loop_count","name":"loop_count","type":"INT","widget":{"name":"loop_count"},"link":null},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"format","name":"format","type":"COMBO","widget":{"name":"format"},"link":null},{"localized_name":"pingpong","name":"pingpong","type":"BOOLEAN","widget":{"name":"pingpong"},"link":null},{"localized_name":"save_output","name":"save_output","type":"BOOLEAN","widget":{"name":"save_output"},"link":null},{"name":"pix_fmt","type":["yuv420p","yuv420p10le"],"widget":{"name":"pix_fmt"},"link":null},{"name":"crf","type":"INT","widget":{"name":"crf"},"link":null},{"name":"save_metadata","type":"BOOLEAN","widget":{"name":"save_metadata"},"link":null},{"name":"trim_to_audio","type":"BOOLEAN","widget":{"name":"trim_to_audio"},"link":null}],"outputs":[{"localized_name":"Filenames","name":"Filenames","type":"VHS_FILENAMES","links":null}],"properties":{"aux_id":"Kosinkadink/ComfyUI-VideoHelperSuite","ver":"4ee72c065db22c9d96c2427954dc69e7b908444b","Node name for S&R":"VHS_VideoCombine","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":{"frame_rate":8,"loop_count":0,"filename_prefix":"videos/minimaxh3/minimax","format":"video/h264-mp4","pix_fmt":"yuv420