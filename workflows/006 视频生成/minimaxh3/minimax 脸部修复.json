,{"localized_name":"blend","name":"blend","type":"FLOAT","widget":{"name":"blend"},"link":null},{"localized_name":"undetected_frames","name":"undetected_frames","type":"COMBO","widget":{"name":"undetected_frames"},"link":null},{"localized_name":"feather_scales_with_crop","name":"feather_scales_with_crop","shape":7,"type":"BOOLEAN","widget":{"name":"feather_scales_with_crop"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":[35]}],"title":"9. Stitch back","properties":{"aux_id":"Carasibana/ComfyUI-H3-FaceRefine","ver":"0.1.2","Node name for S&R":"H3FaceStitch","cnr_id":"comfyui_fearnworksnodes","ue_properties":{"widget_ue_connectable":{"paste_region":true,"mask_dilation":true,"feather":true,"colour_match":true,"blend":true,"undetected_frames":true,"feather_scales_with_crop":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["face_only",24,24,1,1,"fade_out",false],"color":"#1f1f48","bgcolor":"rgba(24,24,27,.9)"},{"id":8,"type":"VHS_LoadAudioUpload","pos":[-1776.7983786669884,1184.8897850236592],"size":[329.5625,243.859375],"flags":{},"order":2,"mode":0,"inputs":[{"localized_name":"audio","name":"audio","type":"COMBO","widget":{"name":"audio"},"link":null},{"localized_name":"start_time","name":"start_time","shape":7,"type":"FLOAT","widget":{"name":"start_time"},"link":null},{"localized_name":"duration","name":"duration","shape":7,"type":"FLOAT","widget":{"name":"duration"},"link":null}],"outputs":[{"localized_name":"audio","name":"audio","type":"AUDIO","links":[7,15]},{"localized_name":"duration","name":"duration","type":"FLOAT","links":null}],"title":"VOCALS - drives lipsync","properties":{"aux_id":"Kosinkadink/ComfyUI-VideoHelperSuite","ver":"0.1.2","Node name for S&R":"VHS_LoadAudioUpload","cnr_id":"comfyui_fearnworksnodes","ue_properties":{"widget_ue_connectable":{"audio":true,"start_time":true,"duration":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":{"audio":"GATONIEL_2.wav","start_time":0,"duration":4,"audiopreview":{"params":{"filename":"GATONIEL_2.wav","type":"input","start_time":0,"duration":4}}},"color":"#006691","bgcolor":"rgba(24,24,27,.9)"},{"id":7,"type":"LoadImage","pos":[-1787.7721673465903,736.4754888976324],"size":[329.5625,373.421875],"flags":{},"order":3,"mode":4,"inputs":[{"localized_name":"图像","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"选择文件上传","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[6]},{"localized_name":"遮罩","name":"MASK","type":"MASK","links":[]}],"title":"Ref 2 - optional (wardrobe etc)","properties":{"cnr_id":"comfy-core","ver":"0.32.0","Node name for S&R":"LoadImage","ue_properties":{"widget_ue_connectable":{"image":true,"upload":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["second_reference.png","image"],"color":"#1f1f48","bgcolor":"rgba(24,24,27,.9)"},{"id":107,"type":"Note","pos":[-2383.220586181419,719.7969454235836],"size":[546.8125,768.078125],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"Canvas size","properties":{"text":"","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["CANVAS SIZE\n\ncanvas_mode decides the resolution H3 generates at:\n\n  manual            - use canvas_width/height exactly as typed\n  auto_no_downscale - size from the LARGEST crop in the clip, so no frame is\n                      ever downscaled. Can get expensive on clips containing\n                      close-ups.\n  auto_capped_768   - same, but clamped to 768 (H3's native short edge, and a\n                      sane VRAM ceiling). This is what ships here.\n\ncanvas_w / canvas_h are WIRED into the H3 node's width/height on purpose. In the auto modes the tracker chooses the size, and if the H3 node disagrees the latent shapes differ and injection refuses. Do not retype them by hand.\n\nWatch the tracker's report for \"magnification < 1.0x\": that means the crop is being DOWNSCALED into the canvas and real detail is being thrown away. Raise the canvas, or skip the clip if it is close-up throughout.\n\nCost scales with canvas AREA x frames, so 768 is 2.25x the latent tokens of 512."],"color":"#432","bgcolor":"#653"},{"id":9,"type":"MiniMaxH3ReferenceToVideo","pos":[-600.0592750106293,286.7659039603694],"size":[371.34375,636.359375],"flags":{},"order":21,"mode":0,"inputs":[{"localized_name":"CLIP","name":"clip","type":"CLIP","link":40},{"localized_name":"VAE","name":"vae","type":"VAE","link":3},{"localized_name":"音频 VAE","name":"audio_vae","type":"VAE","link":4},{"localized_name":"ref_images.ref_image_0","name":"ref_images.ref_image_0","shape":7,"type":"IMAGE","link":5},{"label":"ref_image_1","localized_name":"ref_images.ref_image_1","name":"ref_images.ref_image_1","shape":7,"type":"IMAGE","link":6},{"label":"ref_image_2","localized_name":"ref_images.ref_image_2","name":"ref_images.ref_image_2","shape":7,"type":"IMAGE","link":null},{"label":"ref_video_0","localized_name":"ref_videos.ref_video_0","name":"ref_videos.ref_video_0","shape":7,"type":"IMAGE","link":null},{"label":"ref_video_audio_0","localized_name":"ref_video_audios.ref_video_audio_0","name":"ref_video_audios.ref_video_audio_0","shape":7,"type":"AUDIO","link":null},{"localized_name":"ref_audios.ref_audio_0","name":"ref_audios.ref_audio_0","shape":7,"type":"AUDIO","link":7},{"label":"ref_audio_1","localized_name":"ref_audios.ref_audio_1","name":"ref_audios.ref_audio_1","shape":7,"type":"AUDIO","link":null},{"localized_name":"提示词","name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":null},{"localized_name":"宽度","name":"width","type":"INT","widget":{"name":"width"},"link":37},{"localized_name":"高度","name":"height","type":"INT","widget":{"name":"height"},"link":38},{"localized_name":"视频帧数","name":"length","type":"INT","widget":{"name":"length"},"link":null},{"localized_name":"参考图像尺寸","name":"ref_image_size","type":"COMBO","widget":{"name":"ref_image_size"},"link":null}],"outputs":[{"localized_name":"正向条件","name":"positive","type":"CONDITIONING","links":[17]},{"localized_name":"Latent","name":"LATENT","type":"LATENT","links":[8]}],"title":"3. Conditioning + EMPTY AV latent","properties":{"cnr_id":"comfy-core","ver":"0.32.0","Node name for S&R":"MiniMaxH3ReferenceToVideo","ue_properties":{"widget_ue_connectable":{"prompt":true,"width":true,"height":true,"length":true,"ref_image_size":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["<paste the clip's own prompt here>",512,512,362,"match"],"color":"#232","bgcolor":"#353"},{"id":10,"type":"H3InjectVideoLatent","pos":[-210.05927501062956,301.7659039603694],"size":[329.71875,104.71875],"flags":{},"order":22,"mode":0,"inputs":[{"localized_name":"av_latent","name":"av_latent","type":"LATENT","link":8},{"localized_name":"images","name":"images","type":"IMAGE","link":9},{"localized_name":"vae","name":"vae","type":"VAE","link":10}],"outputs":[{"localized_name":"av_latent","name":"av_latent","type":"LATENT","links":[13]},{"localized_name":"report","name":"report","type":"STRING","links":[]}],"title":"4. Inject real video -> img2img","properties":{"aux_id":"Carasibana/ComfyUI-H3-FaceRefine","ver":"0.1.2","Node name for S&R":"H3InjectVideoLatent","cnr_id":"comfyui_fearnworksnodes","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[],"color":"#1f1f48","bgcolor":"rgba(24,24,27,.9)"},{"id":106,"type":"Note","pos":[-210.05927501062956,451.76590396036937],"size":[332.921875,477.109375],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"title":"Inject Video Latent","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["WHY THIS NODE EXISTS\n\nH3's stock nodes ALWAYS build a zeros latent. References are conditioning that is re-injected every step - never a starting point. So there is no video-to-video path out of the box.\n\nThis encodes the real cropped frames into the VIDEO stream of the joint AV latent, leaving the audio stream alone. That turns SamplerCustomAdvanced + denoise<1.0 into ordinary img2img.\n\nFrame count must sit on H3's 17k+5 grid (5, 22, 39 ... 175, 226, 362). Clips generated by H3 already do."],"color":"#432","bgcolor":"#653"},{"id":101,"type":"Note","pos":[-596.8528948022959,988.9525901582833],"size":[722.078125,467.5],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"title":"Why per-frame crop","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["PER-FRAME CROPPING IS MANDATORY\n\nA single fixed crop is sized by the widest frame. On a push-in the face is then STILL SMALL inside that crop - on exactly the frames that needed help. The benefit vanishes where it matters.\n\nSo the crop SIZE varies per frame, holding the face at a constant fraction of every crop (crop_factor). Every crop is then resized to ONE canvas, because H3 generates a single fixed WxH for a whole sequence.\n\nResult: the face is always large in H3's input, however small it was in the source.\n\nSMOOTHING\nsize_smooth_window (51) is deliberately larger than smooth_window (21). Size jitter makes the crop breathe, which changes the resample factor every frame and reads as shimmer.\n\ngaussian beats savgol here - polynomial fits preserve sharp features by design, which is the opposite of what you want."],"color":"#432","bgcolor":"#653"},{"id":13,"type":"MiniMaxH3NativeAudioLock","pos":[204.04693992777936,249.0396382934084],"size":[315.03125,119.984375],"flags":{},"order":22,"mode":0,"inputs":[{"name":"model","type":"MODEL","link":12},{"name":"av_latent","type":"LATENT","link":13},{"name":"audio_vae","type":"VAE","link":14},{"name":"audio","type":"AUDIO","link":15}],"outputs":[{"name":"model","type":"MODEL","links":[16,18]},{"name":"av_latent","type":"LATENT","links":[23]},{"name":"exact_audio","type":"AUDIO","links":[]}],"title":"5. Lock audio -> LIPSYNC","properties":{"cnr_id":"comfyui_fearnworksnodes","ver":"0.1.2","Node name for S&R":"MiniMaxH3NativeAudioLock","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[],"color":"#232","bgcolor":"#353"},{"id":31,"type":"H3PerFrameDenoise","pos":[204.4559350859413,430.3283887015802],"size":[329.9375,273.8125],"flags":{},"order":26,"mode":0,"inputs":[{"localized_name":"av_latent","name":"av_latent","type":"LATENT","link":23},{"localized_name":"transform","name":"transform","type":"H3FACEXFORM","link":24},{"localized_name":"strength_small_face","name":"strength_small_face","type":"FLOAT","widget":{"name":"strength_small_face"},"link":null},{"localized_name":"strength_large_face","name":"strength_large_face","type":"FLOAT","widget":{"name":"strength_large_face"},"link":null},{"localized_name":"scale_mode","name":"scale_mode","type":"COMBO","widget":{"name":"scale_mode"},"link":null},{"localized_name":"face_px_small","name":"face_px_small","type":"FLOAT","widget":{"name":"face_px_small"},"link":null},{"localized_name":"face_px_large","name":"face_px_large","type":"FLOAT","widget":{"name":"face_px_large"},"link":null},{"localized_name":"gamma","name":"gamma","type":"FLOAT","widget":{"name":"gamma"},"link":null},{"localized_name":"smooth_frames","name":"smooth_frames","type":"INT","widget":{"name":"smooth_frames"},"link":null}],"outputs":[{"localized_name":"av_latent","name":"av_latent","type":"LATENT","links":[25]},{"localized_name":"report","name":"report","type":"STRING","links":[]}],"title":"5b. Per-frame denoise (by face size)","properties":{"aux_id":"Carasibana/ComfyUI-H3-FaceRefine","ver":"0.1.2","Node name for S&R":"H3PerFrameDenoise","cnr_id":"comfyui_fearnworksnodes","ue_properties":{"widget_ue_connectable":{"strength_small_face":true,"strength_large_face":true,"scale_mode":true,"face_px_small":true,"face_px_large":true,"gamma":true,"smooth_frames":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[0.8,0.35,"absolute_px",30,120,1,9],"color":"#006691","bgcolor":"rgba(24,24,27,.9)"},{"id":103,"type":"Note","pos":[183.1153397897176,760.9016491996267],"size":[369.65625,724.609375],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"title":"How lipsync works","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["LIPSYNC\n\nH3 is a JOINT audio-video model. NativeAudioLock:\n  1. encodes real audio into the AUDIO stream of the AV latent\n     (auto-resamples to the VAE's 32kHz - source is usually 48k)\n  2. sets noise_mask = ones(video) / zeros(audio)\n     so ONLY video denoises\n  3. the video branch cross-attends to that fixed audio\n\nThat is what shapes the mouth.\n\nFeed it the VOCALS track, not the full mix - cleaner signal.\n\nThe ORIGINAL audio goes separately into the save node at the far right. Two different audio paths, do not confuse them."],"color":"#432","bgcolor":"#653"},{"id":102,"type":"Note","pos":[593.8723304119543,880.8899505076402],"size":[706.703125,598.4375],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"DENOISE - read before changing","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["DENOISE - THE CRITICAL DIAL\n\nDO NOT carry values over from SDXL-family models. H3 is FLOW MATCHING with a large sigma shift, so the same number means something very different.\n\nsigma = shift*t / (1 + (shift-1)*t)\n\nAt the default shift of 12:\n  denoise 0.02 -> effective 0.197\n  denoise 0.05 -> effective 0.387\n  denoise 0.15 -> effective ~0.66\n  denoise 0.25 -> effective 0.800\n\nThis graph ships denoise 0.45 as a BASE, because it is not applied flat. Node \"3b. Per-frame denoise\" scales it DOWN per frame by face size: small faces keep close to the full 0.45 and get synthesised, large faces drop to ~0.35x of it and keep the detail they already have.\n\nBase and scaling are tuned TOGETHER. If you bypass the per-frame node, drop the base a long way (0.15-0.25) or every large face gets rewritten.\n\nToo low: nothing changes.\nToo high: the head starts drifting relative to the body - a content problem no mask can hide.\n\nNOTE steps and denoise are INDEPENDENT. BasicScheduler builds a (steps/denoise)-long full-range schedule and keeps the lowest steps+1 sigmas, so 4 steps with a turbo LoRA is both fast and gentle.\n\nDo NOT use SplitSigmas for this - on a 4-step schedule at shift 12 even the last split point is already sigma 0.800."],"color":"#432","bgcolor":"#653"},{"id":14,"type":"BasicGuider","pos":[602.022154025828,271.10593037994573],"size":[284.703125,77.953125],"flags":{},"order":24,"mode":0,"inputs":[{"localized_name":"模型","name":"model","type":"MODEL","link":16},{"localized_name":"条件","name":"conditioning","type":"CONDITIONING","link":17}],"outputs":[{"localized_name":"引导器","name":"GUIDER","type":"GUIDER","links":[20]}],"title":"Guider","properties":{"cnr_id":"comfy-core","ver":"0.32.0","Node name for S&R":"BasicGuider","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[]},{"id":19,"type":"VAEDecode","pos":[1406.0597700834367,532.3220931009031],"size":[224.984375,87.1875],"flags":{},"order":28,"mode":0,"inputs":[{"localized_name":"Latent","name":"samples","type":"LATENT","link":26},{"localized_name":"vae","name":"vae","type":"VAE","link":27}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[29]}],"title":"8. Decode refined crops","properties":{"cnr_id":"comfy-core","ver":"0.32.0","Node name for S&R":"VAEDecode","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[],"color":"#232","bgcolor":"#353"},{"id":104,"type":"Note","pos":[1420.347678114372,701.30921159112],"size":[552,756.859375],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[],"title":"Stitch + mask choice","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["STITCH - modelled on Impact Pack's FaceDetailer\n\nKEY POINT: the wide crop exists to give the SAMPLER CONTEXT. It is NOT what gets pasted.\n\nFaceDetailer builds a crop-sized zeros mask with 1s only in the FACE BBOX, dilates it, then Gaussian-blurs it. Only that region composites; everything else keeps its original pixels. Pasting the whole crop covers ~88% of the canvas versus ~16% for the face box - and any change H3 made to hair or background comes back as a rectangle.\n\npaste_region:\n  face_only    - dilated + blurred rect (FaceDetailer's behaviour; ships here)\n  face_ellipse - same, without corners\n  full_crop    - pastes the lot. Risks a visible rectangle.\n\nFEATHER IS IN SOURCE PIXELS, not canvas pixels, so the blend is the same physical width whatever this frame's magnification happens to be. 24 suits a rect mask.\n\nWHY A RECT AND NOT SAM: counter-intuitively the rect usually wins. SAM traces the face tightly, so any drift in the refined face lands right on the silhouette. A slightly looser rect puts the seam in hair and background, where it reads far less.\n\nThe SAM path is shipped separately as H3_Face_Refine_SAM.json - it needs ComfyUI-Impact-Pack. This graph does not."],"color":"#432","bgcolor":"#653"},{"id":23,"type":"VHS_VideoCombine","pos":[2049.1050584854625,292.28448007799085],"size":[389.109375,334],"flags":{},"order":30,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":35},{"localized_name":"audio","name":"audio","shape":7,"type":"AUDIO","link":36},{"localized_name":"meta_batch","name":"meta_batch","shape":7,"type":"VHS_BatchManager","link":null},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":null},{"localized_name":"frame_rate","name":"frame_rate","type":"FLOAT","widget":{"name":"frame_rate"},"link":null},{"localized_name":"loop_count","name":"loop_count","type":"INT","widget":{"name":"loop_count"},"link":null},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"format","name":"format","type":"COMBO","widget":{"name":"format"},"link":null},{"localized_name":"pingpong","name":"pingpong","type":"BOOLEAN","widget":{"name":"pingpong"},"link":null},{"localized_name":"save_output","name":"save_output","type":"BOOLEAN","widget":{"name":"save_output"},"link":null},{"name":"pix_fmt","type":["yuv420p","yuv420p10le"],"widget":{"name":"pix_fmt"},"link":null},{"name":"crf","type":"INT","widget":{"name":"crf"},"link":null},{"name":"save_metadata","type":"BOOLEAN","widget":{"name":"save_metadata"},"link":null},{"name":"trim_to_audio","type":"BOOLEAN","widget":{"name":"trim_to_audio"},"link":null}],"outputs":[{"localized_name":"Filenames","name":"Filenames","type":"VHS_FILENAMES","links":[]}],"title":"10. Save (ORIGINAL audio)","properties":{"aux_id":"Kosinkadink/ComfyUI-VideoHelperSuite","ver":"0.1.2","Node name for S&R":"VHS_VideoCombine","cnr_id":"comfyui_fearnworksnodes","ue_properties":{"widget_ue_connectable":{"frame_rate":true,"loop_count":true,"filename_prefix":true,"format":true,"pingpong":true,"save_output":true,"pix_fmt":true,"crf":true,"save_metadata":true,"trim_to_audio":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":{"frame_rate":24,"loop_count":0,"filename_prefix":"video/FaceRefined/output","format":"video/h264-mp4","pix_fmt":"yuv420p","crf":16,"save_metadata":true,"trim_to_audio":false,"pingpong":false,"save_output":true,"videopreview":{"hidden":false,"paused":false,"params":{"filename":"output_00002-audio.mp4","subfolder":"video\\FaceRefined","type":"output","format":"video/h264-mp4","frame_rate":24,"workflow":"output_00002.png","fullpath":"D:\\Comfy\\ComfyUI\\output\\video\\FaceRefined\\output_00002-audio.mp4"}}},"color":"#006691","bgcolor":"rgba(24,24,27,.9)"},{"id":105,"type":"Note","pos":[2014.892843044924,950.0780972926154],"size":[448.453125,499.0625],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[],"title":"Read each clip's own settings","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["PER-CLIP SETTINGS\n\nClips from one batch are often NOT uniform. Read each clip's OWN embedded workflow rather than assuming:\n\n  ffprobe -v error -show_entries format_tags=prompt -of json yourclip.mp4\n\nThings that commonly vary within a single batch: step count, sampler, whether a turbo LoRA was used at all, and how many reference images were attached.\n\nMirror the clip's own steps / sampler / LoRA / refs here, and change only the denoise settings."],"color":"#432","bgcolor":"#653"},{"id":1,"type":"VHS_LoadVideoPath","pos":[-1006.9910852664071,294.95479187030935],"size":[329.46875,286],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"meta_batch","name":"meta_batch","shape":7,"type":"VHS_BatchManager","link":null},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":null},{"localized_name":"video","name":"video","type":"STRING","widget":{"name":"video"},"link":null},{"localized_name":"force_rate","name":"force_rate","type":"FLOAT","widget":{"name":"force_rate"},"link":null},{"localized_name":"custom_width","name":"custom_width","type":"INT","widget":{"name":"custom_width"},"link":null},{"localized_name":"custom_height","name":"custom_height","type":"INT","widget":{"name":"custom_height"},"link":null},{"localized_name":"frame_load_cap","name":"frame_load_cap","type":"INT","widget":{"name":"frame_load_cap"},"link":null},{"localized_name":"skip_first_frames","name":"skip_first_frames","type":"INT","widget":{"name":"skip_first_frames"},"link":null},{"localized_name":"select_every_nth","name":"select_every_nth","type":"INT","widget":{"name":"select_every_nth"},"link":null},{"localized_name":"format","name":"format","shape":7,"type