MAGE"],[20434,122,0,5906,0,"IMAGE"],[20435,5906,0,5907,0,"IMAGE"],[20436,138,0,136,9,"STRING"],[20440,137,0,5909,0,"IMAGE"],[20441,5906,0,5909,1,"IMAGE"],[20442,5909,0,5910,0,"IMAGE"]],"groups":[{"id":1,"title":"Models","bounding":[-1520,4840,700,670],"color":"#3f789e","flags":{}},{"id":2,"title":"Sampling","bounding":[-280,4840,690,670],"color":"#3f789e","flags":{}},{"id":3,"title":"Conditioning","bounding":[-790,4840,480,670],"color":"#3f789e","flags":{}},{"id":4,"title":"Decoding and create video","bounding":[440,4840,670,670],"color":"#3f789e","flags":{}},{"id":5,"title":"User Inputs","bounding":[-1534.4111704862914,5581.923405051028,1908.7784707810001,1345.6521135989997],"color":"#3f789e","flags":{}},{"id":194,"title":"Optional Speedup - Delete if you want","bounding":[-970,4280,870,530],"color":"#8AA","flags":{}}],"definitions":{"subgraphs":[{"id":"a9d3016d-7cbf-4367-a217-488144b79839","version":1,"state":{"lastGroupId":194,"lastNodeId":5910,"lastLinkId":20442,"lastRerouteId":15},"revision":0,"config":{},"name":"Optional Speedups - 10 Sept 2026","inputNode":{"id":-10,"bounding":[-2508,3956,128,68]},"outputNode":{"id":-20,"bounding":[-390,3956,128,68]},"inputs":[{"id":"e5374e45-aeef-44d6-a592-608e55d6f546","name":"model","type":"MODEL","linkIds":[20405],"localized_name":"model","pos":[-2404,3980]}],"outputs":[{"id":"62a0eef7-f158-491c-8d3a-e6b34cc5ad2c","name":"MODEL","type":"MODEL","linkIds":[20433],"localized_name":"MODEL","pos":[-366,3980]}],"widgets":[],"nodes":[{"id":5888,"type":"MarkdownNote","pos":[-2180,3610],"size":[700,320],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"Note: Speed Patches (PK)","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["## Speed Patches — PK / H3 SLA\n\nChain applies bottom-up on the MODEL. Toggle each group on/off with the bypasser above.\n\n- **1. FP16 Accumulation** (`ModelPatchTorchSettings`): free speed on RTX 30xx+ / most modern GPUs. Safe to leave on.\n- **2. LowVRAM Attention** (`MiniMaxLowVRAMAttention`): splits attention into head chunks. Reduces peak VRAM; tiny cost, sometimes a small speedup. Widget: `head_chunks` (default 4).\n- **3. Chunk FeedForward** (`MiniMaxChunkFeedForward`): splits FF blocks. Reduces peak VRAM at longer sequence lengths. Widgets: `chunks` (2–4), `seq_threshold` (4096).\n- **4. H3 SLA Attention** (`H3SLAAttention`): the big one. Sparse Linear Attention — main speedup. `sparsity_ratio` 0.9 keeps 10% of tokens for very fast, decent-quality; drop to ~0.7 if you see artifacts. `dense_last_steps` controls how many final steps run dense (better quality tail).\n\n### Wiring\n\nFeed the raw `MODEL` from `UNETLoader` into `model`. Take the output `MODEL` to whatever comes next (sampler / patcher).\n\n### Notes\n\n- SLA patches attention — anything else patching attention should sit *before* it in the chain. That is why H3SLAAttention is last.\n- `protect_audio=True` avoids audio-latent glitches at some speed cost. Leave on unless testing.\n- If the workflow refuses to load, install `comfyui-kjnodes` and `plaguekind-nodes` (H3SLAAttention lives in one of these packs)."],"widgets_values_named":{"text":"## Speed Patches — PK / H3 SLA\n\nChain applies bottom-up on the MODEL. Toggle each group on/off with the bypasser above.\n\n- **1. FP16 Accumulation** (`ModelPatchTorchSettings`): free speed on RTX 30xx+ / most modern GPUs. Safe to leave on.\n- **2. LowVRAM Attention** (`MiniMaxLowVRAMAttention`): splits attention into head chunks. Reduces peak VRAM; tiny cost, sometimes a small speedup. Widget: `head_chunks` (default 4).\n- **3. Chunk FeedForward** (`MiniMaxChunkFeedForward`): splits FF blocks. Reduces peak VRAM at longer sequence lengths. Widgets: `chunks` (2–4), `seq_threshold` (4096).\n- **4. H3 SLA Attention** (`H3SLAAttention`): the big one. Sparse Linear Attention — main speedup. `sparsity_ratio` 0.9 keeps 10% of tokens for very fast, decent-quality; drop to ~0.7 if you see artifacts. `dense_last_steps` controls how many final steps run dense (better quality tail).\n\n### Wiring\n\nFeed the raw `MODEL` from `UNETLoader` into `model`. Take the output `MODEL` to whatever comes next (sampler / patcher).\n\n### Notes\n\n- SLA patches attention — anything else patching attention should sit *before* it in the chain. That is why H3SLAAttention is last.\n- `protect_audio=True` avoids audio-latent glitches at some speed cost. Leave on unless testing.\n- If the workflow refuses to load, install `comfyui-kjnodes` and `plaguekind-nodes` (H3SLAAttention lives in one of these packs)."},"color":"#222","bgcolor":"#000"},{"id":5886,"type":"MiniMaxChunkFeedForward","pos":[-1520,4040],"size":[320,90],"flags":{},"order":3,"mode":0,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":20407},{"localized_name":"chunks","name":"chunks","type":"INT","widget":{"name":"chunks"},"link":null},{"localized_name":"seq_threshold","name":"seq_threshold","type":"INT","widget":{"name":"seq_threshold"},"link":null}],"outputs":[{"localized_name":"model","name":"model","type":"MODEL","links":[20408]}],"properties":{"aux_id":"kijai/ComfyUI-KJNodes","ver":"d3cfe21625e5170126ce06fbfcfe1d88108688c3","Node name for S&R":"MiniMaxChunkFeedForward","cnr_id":"comfyui-kjnodes","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[2,4096],"widgets_values_named":{"chunks":2,"seq_threshold":4096},"color":"#222","bgcolor":"#000"},{"id":5883,"type":"LoraLoaderModelOnly","pos":[-810,4030],"size":[340,100],"flags":{},"order":2,"mode":0,"inputs":[{"localized_name":"模型","name":"model","type":"MODEL","link":20397},{"localized_name":"LoRA名称","name":"lora_name","type":"COMBO","widget":{"name":"lora_name"},"link":null},{"localized_name":"模型强度","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null}],"outputs":[{"localized_name":"模型","name":"MODEL","type":"MODEL","links":[20433]}],"title"